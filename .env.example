# ===============================================================
# Umgebungsvariablen – Vorlage
# Lokal: Datei kopieren als .env.local und Werte eintragen.
# Live:  Werte in Vercel unter Project → Settings → Environment Variables.
# Alles ohne Wert ist optional – die App läuft trotzdem.
# ===============================================================

# Öffentliche Adresse der App (für Canonical, Sitemap, Vorschaubilder)
NEXT_PUBLIC_SITE_URL=https://lab.berryverde.com

# --- Datenbank (Neon, über Vercel Marketplace verbunden) ---
DATABASE_URL=

# --- Login (Neon Auth) – siehe docs/LOGIN.md ---
# NEON_AUTH_BASE_URL setzt die Neon-Integration in Vercel automatisch.
NEON_AUTH_BASE_URL=
# Zufälliger Wert, mind. 32 Zeichen (openssl rand -base64 32). In Vercel als "Sensitive".
NEON_AUTH_COOKIE_SECRET=

# --- Dein Lab ---
# Diese Adressen bekommen automatisch die Rolle Admin (kommagetrennt).
ADMIN_EMAILS=
# Verkaufsseite der Mitgliedschaft (Tentary). Leer = berryverde.com
NEXT_PUBLIC_MITGLIEDSCHAFT_URL=

# --- Privat-Modus (eigene Werkzeug-Apps): ganze Seite nur mit Login, nicht bei Google ---
PRIVATE_MODE=
# Nur diese E-Mail-Adressen bekommen Zugang (kommagetrennt). Leer = alle, die sich anmelden.
ALLOWED_EMAILS=

# --- E-Mail-Versand (Resend) für das Kontaktformular ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=
MAIL_FROM="Dein Lab <susan@berryverde.com>"

# --- Google Search Console (nur der Code aus dem Meta-Tag, ohne Anführungszeichen) ---
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Tracking (nur mit Einwilligung; sobald gesetzt, erscheint der Cookie-Banner) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Produktfotos der Rezepturen (Vercel Blob). Wird beim Verbinden des Blob-Speichers mit dem Projekt automatisch gesetzt.
BLOB_READ_WRITE_TOKEN=
